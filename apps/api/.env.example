# ==============================================================================
# VersusLab API Environment Configuration (.env)
# Copy this file to .env and configure your desired credentials.
# Unconfigured cloud providers will start up cleanly and only raise errors when
# specifically requested in a race.
# ==============================================================================

# Single-User Authentication (Disabled for direct access)
AUTH_ENABLED=false

# Request Size & In-Memory Rate Limiting
MAX_UPLOAD_SIZE_BYTES=5242880
RACE_RATE_LIMIT_PER_MINUTE=60
DOCUMENT_RATE_LIMIT_PER_MINUTE=30

# Observability (OpenTelemetry Tracing, Prometheus Metrics & Sentry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=versuslab-api
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Local Ollama Configuration & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_THINK=false
EMBEDDING_DIMENSIONS=768

# RAG Retrieval Settings
RAG_TOP_K=5
RRF_K=60
HYBRID_FETCH_K=20
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
JUDGE_MODEL=openai:gpt-4o-mini

# Cloud Providers (Only API keys are required; base URLs default automatically to official endpoints)
# OpenAI Provider (All models including GPT-4o, o1, o3-mini use the official /v1 endpoint)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: only set if using a proxy (e.g. OpenRouter, DeepSeek, vLLM)

# Anthropic (Claude) Provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # Optional

# Google Gemini Provider
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com  # Optional

# xAI (Grok) Provider
XAI_API_KEY=your_xai_api_key_here
# XAI_BASE_URL=https://api.x.ai/v1  # Optional

# DeepSeek Provider
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # Optional

# Race Timeouts (seconds)
FIRST_TOKEN_TIMEOUT_S=15.0
MODEL_TIMEOUT_S=60.0

# Coordinator Concurrency & Retries
MAX_CONCURRENT_MODEL_CALLS=8
MAX_CONNECTION_RETRIES=2

# Database Configuration (PostgreSQL + asyncpg)
POSTGRES_USER=versuslab
POSTGRES_PASSWORD=versuslab
POSTGRES_DB=versuslab
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://versuslab:versuslab@localhost:5433/versuslab

